#!/bin/zsh -feu

# Common logic to locate .changes file for package

PROGNAME="${0:t}"
for file in /etc/devscripts.conf ~/.devscripts; do
    [ -r "$file" ] && . "$file"
done

DEBRELEASE_DEBS_DIR="${DEBRELEASE_DEBS_DIR%/}"
debsdir="${DEBRELEASE_DEBS_DIR:-..}"

mustsetvar() {
    if [[ -z "$2" ]]; then
        echo >&2 "$PROGNAME: unable to determine $3"
        exit 1
    else
        eval "$1=\"\$2\""
    fi
}

mustsetvar package "$(dpkg-parsechangelog -SSource 2>/dev/null || dpkg-parsechangelog | sed -n 's/^Source: //p')" \
            "source package"
mustsetvar version "$(dpkg-parsechangelog -SVersion 2>/dev/null || dpkg-parsechangelog | sed -n 's/^Version: //p')" \
            "source version"
mustsetvar arch "$(dpkg-architecture -qDEB_HOST_ARCH)" "build architecture"

sversion="${version#*:}"
pv="${package}_${sversion}"
pva="${package}_${sversion}_${arch}"

dsc="$debsdir/$pv.dsc"
changes="$debsdir/$pva.changes"

echo "$changes"

